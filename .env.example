SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
# 只用于本机单人工作台；公共部署保持关闭。设为已有媒体拥有者ID。
LOCAL_SESSION_ENABLED=false
LOCAL_SESSION_USER_ID=0
DB_USERNAME=coursetrace
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=coursetrace
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/coursetrace_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# 空值沿用提供方默认；百炼混合思考模型可设置 false，减少简单任务延迟和输出开销。
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
ASR_MODEL=qwen3-asr-flash
# 百炼 qwen3-asr-flash 使用 chat-completions，并设置 ASR_URL 为对应地域的 /chat/completions。
ASR_PROTOCOL=chat-completions
ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=coursetrace
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
FFMPEG_DIR=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5178,http://127.0.0.1:5178
